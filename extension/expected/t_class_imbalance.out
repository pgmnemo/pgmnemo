-- t_class_imbalance.sql
-- MANDATORY pg_regress test for pgmnemo v0.13.0 — class-imbalance discrimination
--
-- Proves that Beta posterior confidence discriminates good from bad lessons
-- under 85% base success rate — the exact population distribution in prod
-- (OL-260605: 83.5% success in 236 qualifying runs).
--
-- Design:
--   10 "good" lessons: 17 successes, 3 failures each  → posterior = 18/22 ≈ 0.818
--   10 "bad"  lessons:  8 successes, 12 failures each → posterior =  9/22 ≈ 0.409
--
--   Discrimination gap = 0.818 − 0.409 = 0.409 >> 0.30 threshold
--   Additive deltas (legacy): good = 0.48, bad = 0.0 (floor-clamped artifact)
--   Posterior separation is INTERPRETABLE: empirical success rate difference.
--
-- T1: Good avg confidence ∈ [0.810, 0.825] (expected 0.818)
-- T2: Bad  avg confidence ∈ [0.400, 0.420] (expected 0.409)
-- T3: good_avg − bad_avg > 0.30 (discrimination gate)
-- SPDX-License-Identifier: Apache-2.0
SET pgmnemo.gate_strict = 'off';
SET pgmnemo.include_unverified = 'on';
-- ─────────────────────────────────────────────────────────────────────────────
-- Setup: 10 good lessons (17 success, 3 failure each)
--        10 bad  lessons  (8 success, 12 failure each)
-- ─────────────────────────────────────────────────────────────────────────────
DO $setup$
DECLARE
    _id BIGINT;
    _i  INT;
    _j  INT;
BEGIN
    -- Good lessons: 17 successes, 3 failures each
    FOR _i IN 1..10 LOOP
        SELECT pgmnemo.ingest(
            'test_role', 999, 'imbalance_test',
            format('good lesson %s test class imbalance posterior confidence v0130', _i),
            p_commit_sha => format('sha_ci_good_%s', _i)
        ) INTO _id;
        FOR _j IN 1..17 LOOP
            PERFORM pgmnemo.reinforce(_id, 'success', TRUE);
        END LOOP;
        FOR _j IN 1..3 LOOP
            PERFORM pgmnemo.reinforce(_id, 'failure', TRUE);
        END LOOP;
    END LOOP;

    -- Bad lessons: 8 successes, 12 failures each
    FOR _i IN 1..10 LOOP
        SELECT pgmnemo.ingest(
            'test_role', 999, 'imbalance_test',
            format('bad lesson %s test class imbalance posterior confidence v0130', _i),
            p_commit_sha => format('sha_ci_bad_%s', _i)
        ) INTO _id;
        FOR _j IN 1..8 LOOP
            PERFORM pgmnemo.reinforce(_id, 'success', TRUE);
        END LOOP;
        FOR _j IN 1..12 LOOP
            PERFORM pgmnemo.reinforce(_id, 'failure', TRUE);
        END LOOP;
    END LOOP;
END;
$setup$;
-- ─────────────────────────────────────────────────────────────────────────────
-- T1: Good lessons avg confidence = 18/22 ≈ 0.818 (Beta(1,1) posterior)
-- ─────────────────────────────────────────────────────────────────────────────
SELECT
    round(avg(confidence)::numeric, 3) AS good_avg,
    round(avg(confidence)::numeric, 3) BETWEEN 0.810 AND 0.825 AS t1_good_range
FROM pgmnemo.agent_lesson
WHERE topic = 'imbalance_test' AND commit_sha LIKE 'sha_ci_good_%';
 good_avg | t1_good_range 
----------+---------------
    0.818 | t
(1 row)

-- ─────────────────────────────────────────────────────────────────────────────
-- T2: Bad lessons avg confidence = 9/22 ≈ 0.409 (Beta(1,1) posterior)
-- ─────────────────────────────────────────────────────────────────────────────
SELECT
    round(avg(confidence)::numeric, 3) AS bad_avg,
    round(avg(confidence)::numeric, 3) BETWEEN 0.400 AND 0.420 AS t2_bad_range
FROM pgmnemo.agent_lesson
WHERE topic = 'imbalance_test' AND commit_sha LIKE 'sha_ci_bad_%';
 bad_avg | t2_bad_range 
---------+--------------
   0.409 | t
(1 row)

-- ─────────────────────────────────────────────────────────────────────────────
-- T3: Discrimination — good_avg − bad_avg > 0.30
--     (0.818 − 0.409 = 0.409 >> 0.30)
-- ─────────────────────────────────────────────────────────────────────────────
SELECT
    (SELECT avg(confidence) FROM pgmnemo.agent_lesson
     WHERE topic = 'imbalance_test' AND commit_sha LIKE 'sha_ci_good_%')
  - (SELECT avg(confidence) FROM pgmnemo.agent_lesson
     WHERE topic = 'imbalance_test' AND commit_sha LIKE 'sha_ci_bad_%')
  > 0.30 AS t3_discrimination_gate;
 t3_discrimination_gate 
------------------------
 t
(1 row)

-- Cleanup
DELETE FROM pgmnemo.agent_lesson WHERE topic = 'imbalance_test';
